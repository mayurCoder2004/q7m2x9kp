ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
# Comma-separated list of allowed browser origins
FRONTEND_ORIGINS=http://localhost:5173
# Optional regex for preview deployments, e.g. https://windwise-.*\.vercel\.app
FRONTEND_ORIGIN_REGEX=
# Seconds to cache Elexon responses in memory (0 disables)
CACHE_TTL_SECONDS=900
ELEXON_TIMEOUT_SECONDS=45
# Maximum Elexon response body size in bytes before JSON-parsing is refused.
# Prevents SIGSEGV (exit 139) on memory-constrained hosts caused by the Linux
# overcommit path granting a large C-level allocation and then faulting on
# access rather than raising a clean MemoryError. Default: 52428800 (50 MB).
MAX_RESPONSE_BYTES=52428800
